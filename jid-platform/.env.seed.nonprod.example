# =============================================================================
# JID — NON-PRODUCTION cloud seed env (shareable friend testing)
# =============================================================================
# Copy to `.env.seed.nonprod` and fill in. Never commit `.env.seed.nonprod`.
# Never point these values at the production Supabase project or jid.sa.
# =============================================================================

# Required affirmative environment class (script refuses if unset/invalid)
SEED_ENV=nonprod

# Postgres connection string for the NON-PROD Supabase project ONLY
# Project ref must be exactly: hmjuijmaefajdjrjdsxu
# Dashboard → Project Settings → Database → Connection string (URI)
# Example: postgresql://postgres.hmjuijmaefajdjrjdsxu:[password]@aws-0-....pooler.supabase.com:6543/postgres
SEED_DATABASE_URL=

# Public site URL — must be exactly the approved non-prod Vercel app
SHAREABLE_TEST_SITE_URL=https://jid-dev.vercel.app

# Must match the same NON-PROD Supabase project as SEED_DATABASE_URL
NEXT_PUBLIC_SUPABASE_URL=https://hmjuijmaefajdjrjdsxu.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional — used only for safety checks / docs printing
NEXT_PUBLIC_SITE_URL=https://jid-dev.vercel.app
NEXT_PUBLIC_APP_ENV=nonprod

# Do NOT set NEXT_PUBLIC_APP_ENV=production here.
# Do NOT put SUPABASE_SERVICE_ROLE_KEY in client/Vercel public env.
# Privileged credential for this seed path is SEED_DATABASE_URL (server-side only).
